# ========================================================
# Smart Store Safety & Operations Intelligence System
# Environment Configuration
# ========================================================

# Database Connection (MySQL 8.0+)
# If MySQL is not running, backend automatically falls back to local SQLite engine
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_store_db

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Java Validation Module Bin Directory
JAVA_BIN_DIR=java-module/bin
