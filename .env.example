# ========================================================
# Smart Store Safety & Operations Intelligence System
# Environment Configuration
# ========================================================

# Use SQLite for a single-node installation, or provide the production MySQL URL.
DATABASE_URL=sqlite:///./smart_store.db
ALLOW_SQLITE_FALLBACK=false

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development
API_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1

# Java Validation Module Bin Directory
JAVA_BIN_DIR=java-module/bin
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=false
ENABLE_SAMPLE_VIDEO=false
